{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "allowJs": false,
    "noEmit": true
  },

  "include": [
    "app/javascript/**/*"
  ]
}